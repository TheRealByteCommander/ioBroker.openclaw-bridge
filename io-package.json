{
  "common": {
    "name": "openclaw-bridge",
    "version": "0.10.0",
    "news": {
      "0.10.0": {
        "en": "Add per-object AND/OR/XOR guards and max-on duration limits in the admin settings page",
        "de": "Objekt-Regeln mit AND/OR/XOR und maximaler Einschaltdauer in der Admin-Einstellungsseite"
      },
      "0.9.1": {
        "en": "Add typical ioBroker admin settings page (jsonConfig) for all native options",
        "de": "Typische ioBroker-Admin-Einstellungsseite (jsonConfig) für alle Native-Optionen ergänzt"
      },
      "0.9.0": {
        "en": "Add habit learning phases and post-learning home automation optimization for OpenClaw agents",
        "de": "Gewohnheitslernen mit Phasenmodell und anschließender Home-Automation-Optimierung für OpenClaw-Agenten"
      },
      "0.4.0": {
        "en": "Add validatePlan dry-run checks and bounded context event history with getContextEvents",
        "de": "validatePlan Dry-Run-Prüfung und begrenzte Kontext-Event-Historie mit getContextEvents ergänzt"
      },
      "0.3.0": {
        "en": "Add conversational intent handling, context events, critical-action confirmation and PV surplus trigger",
        "de": "Conversational Intent-Handling, Kontext-Events, Bestätigung für kritische Aktionen und PV-Überschuss-Trigger ergänzt"
      },
      "0.2.0": {
        "en": "Add request correlation, structured errors, action whitelist, ACL checks, timeout handling, audit metrics and batch getStates",
        "de": "Request-Korrelation, strukturierte Fehler, Action-Whitelist, ACL-Prüfungen, Timeout-Handling, Audit-Metriken und batch getStates ergänzt"
      },
      "0.1.0": {
        "en": "Initial MVP bridge for ioBroker state read/write from OpenClaw workflows",
        "de": "Initiales MVP-Bridge für ioBroker State-Read/Write aus OpenClaw-Workflows"
      },
      "0.5.0": {
        "en": "Add operator help action, error nextAction guidance and setup/troubleshooting UX docs",
        "de": "Operator-Hilfeaktion, nextAction-Fehlerhinweise und Setup/Troubleshooting-UX-Dokumentation ergänzt"
      },
      "0.6.0": {
        "en": "Add batchSetStates, syncSnapshot, telemetry action, retry/backoff reliability and queue high-watermark protection",
        "de": "batchSetStates, syncSnapshot, Telemetrie-Action, Retry/Backoff-Reliability und Queue-High-Watermark-Schutz ergänzt"
      },
      "0.8.0": {
        "en": "Add Alexa speak action, local STT transcribe action and end-to-end voiceCommand routing with guardrails",
        "de": "Alexa speak Action, lokale STT transcribe Action und End-to-End voiceCommand Routing mit Guardrails ergänzt"
      }
    },
    "titleLang": {
      "en": "OpenClaw Bridge",
      "de": "OpenClaw Bridge"
    },
    "desc": {
      "en": "Bridge adapter exposing command and result states for external assistants",
      "de": "Bridge-Adapter mit Command- und Result-States für OpenClaw: Gewohnheiten lernen, danach Home Automation steuern und optimieren"
    },
    "authors": [
      "Byte Commander"
    ],
    "keywords": [
      "openclaw",
      "bridge",
      "assistant"
    ],
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "mode": "daemon",
    "type": "misc-data",
    "icon": "openclaw-bridge.png",
    "enabled": true,
    "extIcon": "",
    "readme": "https://github.com/TheRealByteCommander/ioBroker/blob/master/README.md",
    "loglevel": "info",
    "messagebox": true,
    "connectionType": "local",
    "dataSource": "push",
    "compact": true,
    "adminUI": {
      "config": "json"
    }
  },
  "native": {
    "allowedPrefixes": "javascript.0,0_userdata.0,alexa2.0",
    "allowedActions": "getState,setState,listStates,getStates,ping,help,handleIntent,executePlan,validatePlan,emitContextEvent,getContextEvents,handlePvSurplus,batchSetStates,syncSnapshot,getTelemetry,speak,transcribe,voiceCommand,recordObservation,getHabits,getLearningStatus,setHabitMode,evaluateHabits,suggestAutomation,applyHabit,optimizeHome,checkGuards",
    "commandTimeoutMs": 5000,
    "setStateAckAllowed": true,
    "criticalStatePrefixes": "system.,admin.0",
    "requireConfirmationActions": "executePlan",
    "comfortTemperatureStateId": "0_userdata.0.hvac.livingRoom.targetTemperature",
    "comfortTempStep": 1,
    "contextEventHistoryLimit": 50,
    "pvSurplusMinWatts": 1500,
    "pvSurplusLoadStateId": "0_userdata.0.energy.pvSurplusMode",
    "retryAttempts": 3,
    "retryBackoffMs": 100,
    "maxBatchOperations": 25,
    "queueHighWatermark": 100,
    "alexaTtsStateId": "alexa2.0.Echo-Devices.Speak",
    "sttCommand": "faster-whisper",
    "sttModel": "small",
    "sttLanguage": "de",
    "habitMode": "observe",
    "habitMinObservations": 7,
    "habitMinDays": 3,
    "habitMinConfidence": 0.65,
    "habitSlotMinutes": 30,
    "habitMatchSlackMinutes": 30,
    "habitObservationLimit": 500,
    "habitOverrideCooldownMs": 7200000,
    "habitMinApplyIntervalMs": 1800000,
    "habitAutoPromote": true,
    "habitLearnFromCommands": true,
    "habitWatchPrefixes": "",
    "habitLightStateId": "0_userdata.0.light.livingroom",
    "habitBedtimeTemperature": 18,
    "habitMorningTemperature": 21,
    "habitScenesJson": "",
    "guardRules": []
  },
