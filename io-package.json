{
  "common": {
    "name": "openclaw-bridge",
    "version": "0.12.1",
    "news": {
      "0.12.1": {
        "en": "In-adapter handbook (Guide tab, ANLEITUNG.html). Current release: operating envelope, habit learning, object rules, PV thresholds. Version news are listed newest-first so Admin matches the installed version.",
        "de": "Anleitung im Adapter (Tab Anleitung, ANLEITUNG.html). Aktueller Stand: Rahmenbedingungen, Gewohnheiten, Objekt-Regeln, PV-Schwellwerte. Versionshinweise stehen neueste zuerst, damit Admin zur installierten Version passt."
      },
      "0.12.0": {
        "en": "Operating envelope: OpenClaw plans only within ACL, AND/OR/XOR, thresholds and max on-time (getConstraints, planWithinBounds).",
        "de": "Rahmenbedingungen: OpenClaw plant nur innerhalb von ACL, AND/OR/XOR, Schwellwerten und max. Einschaltdauer (getConstraints, planWithinBounds)."
      },
      "0.11.0": {
        "en": "Numeric thresholds and per-load PV surplus switching (e.g. pool heating from 4000 W).",
        "de": "Zahlen-Schwellwerte und PV-Überschuss je Last (z. B. Poolheizung ab 4000 W)."
      },
      "0.10.0": {
        "en": "Per-object AND/OR/XOR guards and max-on duration limits in the admin settings page.",
        "de": "Objekt-Regeln mit AND/OR/XOR und maximaler Einschaltdauer in der Admin-Einstellungsseite."
      },
      "0.9.1": {
        "en": "Typical ioBroker admin settings page (jsonConfig) for all native options.",
        "de": "Typische ioBroker-Admin-Einstellungsseite (jsonConfig) für alle Native-Optionen."
      },
      "0.9.0": {
        "en": "Habit learning phases and post-learning home automation optimization for OpenClaw agents.",
        "de": "Gewohnheitslernen mit Phasenmodell und Home-Automation-Optimierung für OpenClaw-Agenten."
      },
      "0.8.0": {
        "en": "Alexa speak, local STT transcribe and voiceCommand routing with guardrails.",
        "de": "Alexa speak, lokale STT transcribe und voiceCommand-Routing mit Guardrails."
      },
      "0.6.0": {
        "en": "batchSetStates, syncSnapshot, telemetry, retry/backoff and queue high-watermark.",
        "de": "batchSetStates, syncSnapshot, Telemetrie, Retry/Backoff und Queue-High-Watermark."
      },
      "0.5.0": {
        "en": "help action, nextAction error guidance and setup/troubleshooting docs.",
        "de": "help-Action, nextAction-Fehlerhinweise und Setup-/Troubleshooting-Doku."
      },
      "0.4.0": {
        "en": "validatePlan dry-run and bounded context event history (getContextEvents).",
        "de": "validatePlan Dry-Run und begrenzte Kontext-Event-Historie (getContextEvents)."
      },
      "0.3.0": {
        "en": "Conversational intents, context events, critical-action confirmation and PV surplus trigger.",
        "de": "Conversational Intents, Kontext-Events, Bestätigung für kritische Aktionen und PV-Trigger."
      },
      "0.2.0": {
        "en": "Request correlation, structured errors, action whitelist, ACL, timeouts and getStates.",
        "de": "Request-Korrelation, strukturierte Fehler, Action-Whitelist, ACL, Timeouts und getStates."
      },
      "0.1.0": {
        "en": "Initial MVP bridge for ioBroker state read/write from OpenClaw workflows.",
        "de": "Initiales MVP: JSON-Commands von OpenClaw nach ioBroker States."
      }
    },
    "titleLang": {
      "en": "OpenClaw Bridge",
      "de": "OpenClaw Bridge"
    },
    "desc": {
      "en": "JSON bridge for OpenClaw: learn habits, then control and optimize home automation only within operator-configured constraints",
      "de": "JSON-Bridge für OpenClaw: Gewohnheiten lernen, danach Home Automation nur innerhalb der gesetzten Rahmenbedingungen steuern und optimieren"
    },
    "authors": [
      "Byte Commander"
    ],
    "keywords": [
      "openclaw",
      "bridge",
      "assistant"
    ],
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "mode": "daemon",
    "type": "misc-data",
    "icon": "openclaw-bridge.png",
    "enabled": true,
    "extIcon": "",
    "readme": "https://github.com/TheRealByteCommander/ioBroker.openclaw-bridge/blob/master/README.md",
    "docs": {
      "de": ["docs/de/ANLEITUNG.md"],
      "en": ["docs/en/HANDBOOK.md"]
    },
    "loglevel": "info",
    "messagebox": true,
    "connectionType": "local",
    "dataSource": "push",
    "compact": true,
    "adminUI": {
      "config": "json"
    }
  },
  "native": {
    "allowedPrefixes": "javascript.0,0_userdata.0,alexa2.0",
    "allowedActions": "getState,setState,listStates,getStates,ping,help,handleIntent,executePlan,validatePlan,emitContextEvent,getContextEvents,handlePvSurplus,batchSetStates,syncSnapshot,getTelemetry,speak,transcribe,voiceCommand,recordObservation,getHabits,getLearningStatus,setHabitMode,evaluateHabits,suggestAutomation,applyHabit,optimizeHome,checkGuards,getConstraints,planWithinBounds",
    "commandTimeoutMs": 5000,
    "setStateAckAllowed": true,
    "criticalStatePrefixes": "system.,admin.0",
    "requireConfirmationActions": "executePlan",
    "comfortTemperatureStateId": "0_userdata.0.hvac.livingRoom.targetTemperature",
    "comfortTempStep": 1,
    "contextEventHistoryLimit": 50,
    "pvSurplusMinWatts": 1500,
    "pvSurplusLoadStateId": "0_userdata.0.energy.pvSurplusMode",
    "pvPowerStateId": "0_userdata.0.energy.pvSurplusWatts",
    "surplusLoads": [],
    "retryAttempts": 3,
    "retryBackoffMs": 100,
    "maxBatchOperations": 25,
    "queueHighWatermark": 100,
    "alexaTtsStateId": "alexa2.0.Echo-Devices.Speak",
    "sttCommand": "faster-whisper",
    "sttModel": "small",
    "sttLanguage": "de",
    "habitMode": "observe",
    "habitMinObservations": 7,
    "habitMinDays": 3,
    "habitMinConfidence": 0.65,
    "habitSlotMinutes": 30,
    "habitMatchSlackMinutes": 30,
    "habitObservationLimit": 500,
    "habitOverrideCooldownMs": 7200000,
    "habitMinApplyIntervalMs": 1800000,
    "habitAutoPromote": true,
    "habitLearnFromCommands": true,
    "habitWatchPrefixes": "",
    "habitLightStateId": "0_userdata.0.light.livingroom",
    "habitBedtimeTemperature": 18,
    "habitMorningTemperature": 21,
    "habitScenesJson": "",
    "guardRules": []
  },
