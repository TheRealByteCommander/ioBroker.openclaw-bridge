    "comfortTempStep": 1,
    "contextEventHistoryLimit": 50,
    "pvSurplusMinWatts": 1500,
    "pvSurplusLoadStateId": "0_userdata.0.energy.pvSurplusMode",
    "pvPowerStateId": "0_userdata.0.energy.pvSurplusWatts",
    "surplusLoads": [],
    "retryAttempts": 3,
    "retryBackoffMs": 100,
    "maxBatchOperations": 25,
    "queueHighWatermark": 100,
    "alexaTtsStateId": "alexa2.0.Echo-Devices.Speak",
    "sttCommand": "faster-whisper",
    "sttModel": "small",
    "sttLanguage": "de",
    "habitMode": "observe",
    "habitMinObservations": 7,
    "habitMinDays": 3,
    "habitMinConfidence": 0.65,
    "habitSlotMinutes": 30,
    "habitMatchSlackMinutes": 30,
    "habitObservationLimit": 500,
    "habitOverrideCooldownMs": 7200000,
    "habitMinApplyIntervalMs": 1800000,
    "habitAutoPromote": true,
    "habitLearnFromCommands": true,
    "habitWatchPrefixes": "",
    "habitLightStateId": "0_userdata.0.light.livingroom",
    "habitBedtimeTemperature": 18,
    "habitMorningTemperature": 21,
    "habitScenesJson": "",
    "guardRules": [],
    "sttAudioDir": "",
    "authToken": "",
    "httpEnabled": false,
    "httpBind": "127.0.0.1",
    "httpPort": 8097,
    "responseRetentionMinutes": 60,
    "idempotencyTtlMinutes": 10,
    "agentHeartbeatMinutes": 15,
    "confirmationMode": "agent",
    "confirmationTtlMinutes": 10,
    "confirmationDenySources": "system.adapter.simple-api,system.adapter.rest-api,system.adapter.openclaw-bridge",
    "openclawWebhookUrl": "",
    "openclawWebhookToken": "",
    "openclawWebhookMode": "agent",
    "openclawAgentId": "",
    "openclawDeliver": true,
    "openclawNotifyEvents": "guard_block,max_on_elapsed,confirmation_pending,confirmation_resolved",
    "openclawWatchStates": "",
    "notifyMinIntervalSec": 60
