{
  "common": {
    "name": "openclaw-bridge",
    "version": "0.12.4",
    "news": {
      "0.12.4": {
        "en": "Admin available version: overwrite stale repo cache (e.g. 0.9.0) on start and ship sources-dist.json for a custom repository.",
        "de": "Admin verfügbare Version: veralteten Repo-Cache (z. B. 0.9.0) beim Start überschreiben und sources-dist.json für ein eigenes Repository mitliefern."
      },
      "0.12.3": {
        "en": "Create the command channel at startup (control.command, responses, info). io-package uses instanceObjects so upgrades recreate the OpenClaw API states.",
        "de": "Steuerkanal beim Start anlegen (control.command, responses, info). io-package nutzt instanceObjects, damit Upgrades die OpenClaw-API-States wiederherstellen."
      },
      "0.12.2": {
        "en": "Guide tab shows the handbook in the instance (iframe + full text). Available version no longer sticks at 0.9.x: news only keeps 0.10+ keys so Admin string-compare cannot treat 0.9.0 as newer than 0.12.",
        "de": "Tab Anleitung zeigt die Anleitung in der Instanz (iframe + Volltext). Verfügbare Version bleibt nicht mehr bei 0.9.x: News nur noch 0.10+, damit Admins String-Vergleich 0.9.0 nicht für neuer als 0.12 hält."
      },
      "0.12.1": {
        "en": "In-adapter handbook (Guide tab, ANLEITUNG.html). Current release: operating envelope, habit learning, object rules, PV thresholds. Version news are listed newest-first so Admin matches the installed version.",
        "de": "Anleitung im Adapter (Tab Anleitung, ANLEITUNG.html). Aktueller Stand: Rahmenbedingungen, Gewohnheiten, Objekt-Regeln, PV-Schwellwerte. Versionshinweise stehen neueste zuerst, damit Admin zur installierten Version passt."
      },
      "0.12.0": {
        "en": "Operating envelope: OpenClaw plans only within ACL, AND/OR/XOR, thresholds and max on-time (getConstraints, planWithinBounds).",
        "de": "Rahmenbedingungen: OpenClaw plant nur innerhalb von ACL, AND/OR/XOR, Schwellwerten und max. Einschaltdauer (getConstraints, planWithinBounds)."
      }
    },
    "titleLang": {
      "en": "OpenClaw Bridge",
      "de": "OpenClaw Bridge"
    },
    "desc": {
      "en": "JSON bridge for OpenClaw: learn habits, then control and optimize home automation only within operator-configured constraints",
      "de": "JSON-Bridge für OpenClaw: Gewohnheiten lernen, danach Home Automation nur innerhalb der gesetzten Rahmenbedingungen steuern und optimieren"
    },
    "authors": [
      "Byte Commander"
    ],
    "keywords": [
      "openclaw",
      "bridge",
      "assistant"
    ],
    "license": "MIT",
    "licenseInformation": {
      "license": "MIT",
      "type": "free"
    },
    "platform": "Javascript/Node.js",
    "mode": "daemon",
    "type": "misc-data",
    "icon": "openclaw-bridge.png",
    "enabled": true,
    "extIcon": "https://raw.githubusercontent.com/TheRealByteCommander/ioBroker.openclaw-bridge/master/openclaw-bridge.png",
    "readme": "https://github.com/TheRealByteCommander/ioBroker.openclaw-bridge/blob/master/README.md",
    "docs": {
      "de": [
        "docs/de/ANLEITUNG.md"
      ],
      "en": [
        "docs/en/HANDBOOK.md"
      ]
    },
    "loglevel": "info",
    "messagebox": true,
    "connectionType": "local",
    "dataSource": "push",
    "compact": true,
    "adminUI": {
      "config": "json"
    }
  },
  "native": {
    "allowedPrefixes": "javascript.0,0_userdata.0,alexa2.0",
    "allowedActions": "getState,setState,listStates,getStates,ping,help,handleIntent,executePlan,validatePlan,emitContextEvent,getContextEvents,handlePvSurplus,batchSetStates,syncSnapshot,getTelemetry,speak,transcribe,voiceCommand,recordObservation,getHabits,getLearningStatus,setHabitMode,evaluateHabits,suggestAutomation,applyHabit,optimizeHome,checkGuards,getConstraints,planWithinBounds",
    "commandTimeoutMs": 5000,
    "setStateAckAllowed": true,
    "criticalStatePrefixes": "system.,admin.0",
    "requireConfirmationActions": "executePlan",
    "comfortTemperatureStateId": "0_userdata.0.hvac.livingRoom.targetTemperature",
    "comfortTempStep": 1,
    "contextEventHistoryLimit": 50,
    "pvSurplusMinWatts": 1500,
    "pvSurplusLoadStateId": "0_userdata.0.energy.pvSurplusMode",
    "pvPowerStateId": "0_userdata.0.energy.pvSurplusWatts",
    "surplusLoads": [],
    "retryAttempts": 3,
    "retryBackoffMs": 100,
    "maxBatchOperations": 25,
    "queueHighWatermark": 100,
    "alexaTtsStateId": "alexa2.0.Echo-Devices.Speak",
    "sttCommand": "faster-whisper",
    "sttModel": "small",
    "sttLanguage": "de",
    "habitMode": "observe",
    "habitMinObservations": 7,
    "habitMinDays": 3,
    "habitMinConfidence": 0.65,
    "habitSlotMinutes": 30,
    "habitMatchSlackMinutes": 30,
    "habitObservationLimit": 500,
    "habitOverrideCooldownMs": 7200000,
    "habitMinApplyIntervalMs": 1800000,
    "habitAutoPromote": true,
    "habitLearnFromCommands": true,
    "habitWatchPrefixes": "",
    "habitLightStateId": "0_userdata.0.light.livingroom",
    "habitBedtimeTemperature": 18,
    "habitMorningTemperature": 21,
    "habitScenesJson": "",
    "guardRules": []
  },
