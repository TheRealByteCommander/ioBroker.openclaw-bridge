{
  "common": {
    "name": "openclaw-bridge",
    "version": "0.13.2",
    "news": {
      "0.13.2": {
        "en": "Writes to unknown or read-only state ids are rejected (EIDUNKNOWN/EREADONLY) instead of creating phantom states; plans are validated before the first write. Plugin results state success explicitly. Found in a chat test with a local model.",
        "de": "Schreibzugriffe auf unbekannte oder schreibgeschützte IDs werden abgelehnt (EIDUNKNOWN/EREADONLY) statt Phantom-States anzulegen; Pläne werden vor dem ersten Schreiben geprüft. Plugin-Ergebnisse melden Erfolg explizit. Gefunden im Chat-Test mit lokalem Modell."
      },
      "0.13.1": {
        "en": "OpenClaw plugin works on OpenClaw 2026.3.x (no SDK import, install without config, matching id). Docs: enable tools via tools.alsoAllow. Field test on js-controller 7.",
        "de": "OpenClaw-Plugin läuft auf OpenClaw 2026.3.x (kein SDK-Import, Installation ohne Config, passende ID). Doku: Tools über tools.alsoAllow freigeben. Praxistest auf js-controller 7."
      },
      "0.13.0": {
        "en": "OpenClaw interface: REST API with bearer token, tool catalog, event push via OpenClaw webhook, SSE stream, OpenClaw skill and plugin. Serial command queue, timeout abort, idempotent requestId, human confirmation mode, response cleanup, restricted STT audio directory.",
        "de": "OpenClaw-Schnittstelle: REST-API mit Bearer-Token, Tool-Katalog, Event-Push per OpenClaw-Webhook, SSE-Stream, OpenClaw-Skill und -Plugin. Serielle Command-Queue, Abbruch bei Timeout, idempotente requestId, menschliche Bestätigung, Aufräumen alter Antworten, festes STT-Audioverzeichnis."
      },
      "0.12.5": {
        "en": "Keep a newer repository version in Admin so an update is visible; only overwrite stale older cache (e.g. 0.9.0).",
        "de": "Neuere Repository-Version in Admin behalten, damit ein Update sichtbar bleibt; nur veralteten älteren Cache (z. B. 0.9.0) überschreiben."
      },
      "0.12.4": {
        "en": "Admin available version: overwrite stale repo cache (e.g. 0.9.0) on start and ship sources-dist.json for a custom repository.",
        "de": "Admin verfügbare Version: veralteten Repo-Cache (z. B. 0.9.0) beim Start überschreiben und sources-dist.json für ein eigenes Repository mitliefern."
      },
      "0.12.3": {
        "en": "Create the command channel at startup (control.command, responses, info). io-package uses instanceObjects so upgrades recreate the OpenClaw API states.",
        "de": "Steuerkanal beim Start anlegen (control.command, responses, info). io-package nutzt instanceObjects, damit Upgrades die OpenClaw-API-States wiederherstellen."
      },
      "0.12.2": {
        "en": "Guide tab shows the handbook in the instance (iframe + full text). Available version no longer sticks at 0.9.x: news only keeps 0.10+ keys so Admin string-compare cannot treat 0.9.0 as newer than 0.12.",
        "de": "Tab Anleitung zeigt die Anleitung in der Instanz (iframe + Volltext). Verfügbare Version bleibt nicht mehr bei 0.9.x: News nur noch 0.10+, damit Admins String-Vergleich 0.9.0 nicht für neuer als 0.12 hält."
      },
      "0.12.1": {
        "en": "In-adapter handbook (Guide tab, ANLEITUNG.html). Current release: operating envelope, habit learning, object rules, PV thresholds. Version news are listed newest-first so Admin matches the installed version.",
        "de": "Anleitung im Adapter (Tab Anleitung, ANLEITUNG.html). Aktueller Stand: Rahmenbedingungen, Gewohnheiten, Objekt-Regeln, PV-Schwellwerte. Versionshinweise stehen neueste zuerst, damit Admin zur installierten Version passt."
      }
    },
    "titleLang": {
      "en": "OpenClaw Bridge",
      "de": "OpenClaw Bridge"
    },
    "desc": {
      "en": "JSON bridge for OpenClaw: learn habits, then control and optimize home automation only within operator-configured constraints",
      "de": "JSON-Bridge für OpenClaw: Gewohnheiten lernen, danach Home Automation nur innerhalb der gesetzten Rahmenbedingungen steuern und optimieren"
    },
    "authors": [
      "Byte Commander"
    ],
    "keywords": [
      "openclaw",
      "bridge",
      "assistant"
    ],
    "license": "MIT",
    "licenseInformation": {
      "license": "MIT",
      "type": "free"
    },
    "platform": "Javascript/Node.js",
    "mode": "daemon",
    "type": "misc-data",
    "icon": "openclaw-bridge.png",
    "enabled": true,
    "extIcon": "https://raw.githubusercontent.com/TheRealByteCommander/ioBroker.openclaw-bridge/master/openclaw-bridge.png",
    "readme": "https://github.com/TheRealByteCommander/ioBroker.openclaw-bridge/blob/master/README.md",
    "docs": {
      "de": [
        "docs/de/ANLEITUNG.md"
      ],
      "en": [
        "docs/en/HANDBOOK.md"
      ]
